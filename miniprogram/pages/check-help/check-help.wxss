/* pages/check-help/check-help.wxss */

page {
  background-color: #e8f5e8;
}

.page {
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.hero {
  padding: 26rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #5cb85c, #3f9a52);
  box-shadow: 0 6rpx 18rpx rgba(76, 175, 80, 0.25);
}

.hero-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.92);
}

/* ===== 警示块 ===== */
.alert {
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid #f56c6c;
  background: #fef0f0;
}

.alert-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #c45656;
  margin-bottom: 8rpx;
}

.alert-text {
  font-size: 27rpx;
  color: #a33a3a;
  line-height: 1.65;
}

/* ===== 卡片 ===== */
.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 26rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  position: relative;
  font-size: 31rpx;
  font-weight: bold;
  color: #2f6b33;
  padding-left: 20rpx;
  margin-bottom: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #5cb85c;
}

/* ===== 步骤 ===== */
.step {
  display: flex;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #eef2ee;
}

.step--last {
  border-bottom: none;
}

.step-no {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(92, 184, 92, 0.15);
  color: #3d7a3d;
  font-size: 26rpx;
  font-weight: bold;
}

.step-body {
  flex: 1;
}

.step-name {
  font-size: 29rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #5f6b5f;
  line-height: 1.6;
}

/* ===== 对比行 ===== */
.cmp-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
}

.cmp-tag {
  flex-shrink: 0;
  width: 88rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 10rpx;
  padding: 6rpx 0;
}

.cmp-tag--over {
  background: rgba(230, 162, 60, 0.15);
  color: #b8860b;
}

.cmp-tag--loss {
  background: rgba(245, 108, 108, 0.15);
  color: #c45656;
}

.cmp-tag--ok {
  background: rgba(103, 194, 58, 0.15);
  color: #4a9e2f;
}

.cmp-text {
  flex: 1;
  font-size: 26rpx;
  color: #4a534a;
  line-height: 1.6;
}

/* ===== 状态 ===== */
.status-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.status-tag {
  flex-shrink: 0;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.status-checked {
  background: rgba(103, 194, 58, 0.15);
  color: #4a9e2f;
}

.status-unchecked {
  background: rgba(245, 108, 108, 0.12);
  color: #c45656;
}

.status-unknown {
  background: #f0f2f0;
  color: #8b968b;
}

.status-text {
  flex: 1;
  font-size: 26rpx;
  color: #5f6b5f;
  line-height: 1.55;
}

/* ===== 按钮说明 ===== */
.btn-explain {
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #eef2ee;
}

.btn-explain:last-child {
  border-bottom: none;
}

.btn-explain-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.btn-explain-desc {
  font-size: 26rpx;
  color: #5f6b5f;
  line-height: 1.6;
}

/* ===== 注意项 ===== */
.note {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #5f6b5f;
  line-height: 1.75;
  padding: 16rpx 0;   /* 原 8rpx，行间距翻倍 */
}

/* 正文整体包一层，避免内部 <text class="em"> 被 flex 当成独立列拆开 */
.note-text {
  flex: 1;
  min-width: 0;
}

/* 圆点加大：字形换成 •（U+2022，实心圆），字号放大并锁定行高对齐首行 */
.dot {
  flex-shrink: 0;
  width: 26rpx;
  margin-right: 10rpx;
  color: #5cb85c;
  font-size: 34rpx;
  font-weight: bold;
  line-height: 1.34;
  text-align: center;
}

/* ===== 小提示 ===== */
.tip-line {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f5faf5;
  font-size: 24rpx;
  color: #6f7c6f;
  line-height: 1.6;
}

.tip-line--danger {
  background: #fef0f0;
  color: #b04a4a;
}

/* ===== 强调文字 ===== */
.em {
  font-weight: bold;
  color: #2f6b33;
}

.em--danger {
  color: #f56c6c;
}

.footer-space {
  height: env(safe-area-inset-bottom);
}
