<!--pages/stock-check/stock-check.wxml-->
<view class="container">
  <!-- 顶部标题区域 -->
  <view class="header">
    <view class="header-top">
      <view class="title-wrapper">
        <view class="title">扫码统计</view>
      </view>

      <view class="header-btns">
        <!-- 手动报溢 -->
        <button
          class="btn-overflow-small"
          size="mini"
          bindtap="goManualOverflow"
        >手动报溢</button>

        <!-- 重新开始按钮 -->
        <button
          wx:if="{{progress.is_in_progress}}"
          class="btn-restart-small"
          size="mini"
          bindtap="handleStartCheck"
          disabled="{{startLoading}}"
          loading="{{startLoading}}"
        >重新开始</button>
      </view>
    </view>

    <!-- 进度展示 -->
    <view class="progress-section" wx:if="{{progress.is_in_progress}}">
      <view class="progress-label">
        <text>已统计 </text>
        <text class="progress-checked">{{progress.checked}}</text>
        <text> / 待统计 </text>
        <text class="progress-unchecked">{{progress.unchecked}}</text>
        <text>（{{progressPercent}}%）</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressWidth}}"></view>
      </view>
    </view>

    <!-- 开始统计按钮 -->
    <view class="start-btn-wrap">
      <button
        wx:if="{{!progress.is_in_progress}}"
        class="btn-start"
        bindtap="handleStartCheck"
        disabled="{{startLoading}}"
        loading="{{startLoading}}"
      >新建统计</button>
    </view>
  </view>

  <!-- 搜索区域 -->
  <view class="search-section card">
    <view class="search-input-wrap">
      <input
        class="search-input"
        value="{{searchKey}}"
        placeholder="输入名称、拼音或扫码"
        bindinput="onSearchInput"
        bindconfirm="doSearch"
        confirm-type="search"
      />
      <view class="search-clear" wx:if="{{searchKey}}" bindtap="clearSearch">
        <text>✕</text>
      </view>
    </view>
    <!-- 查找按钮（放大镜图标） -->
    <view class="icon-btn search-btn-icon" bindtap="doSearch">
      <view class="magnifier-icon">
        <view class="magnifier-circle"></view>
        <view class="magnifier-handle"></view>
      </view>
    </view>
    <!-- 扫码按钮 -->
    <view class="icon-btn scan-btn" bindtap="handleScan">
      <view class="scan-icon-btn">
        <view class="scan-frame-line"></view>
      </view>
    </view>
  </view>

  <!-- 指定货位（全局） -->
  <view class="specified-allocation-section card" wx:if="{{progress.is_in_progress}}">
    <view class="specified-allocation-row" bindtap="openAllocationDialog">
      <text class="info-label">指定货位</text>
      <view class="info-value allocation-value">
        <text wx:if="{{specifiedAllocationName}}" class="allocation-text">{{specifiedAllocationName}}</text>
        <text wx:else class="allocation-placeholder">点击设置货位</text>
        <text class="arrow-right">›</text>
      </view>
    </view>
    <view class="auto-link-row">
      <text class="auto-link-label">自动关联</text>
      <switch checked="{{autoLinkEnabled}}" bindchange="onAutoLinkChange" color="#5cb85c" />
    </view>
  </view>

  <!-- Loading 提示 -->
  <view class="loading-section" wx:if="{{searchLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在查询...</text>
  </view>

  <!-- 搜索结果列表 -->
  <view class="search-results" wx:if="{{searchResults.length > 0 && !currentItem && !searchLoading}}">
    <view
      class="result-item"
      wx:for="{{searchResults}}"
      wx:key="id"
      bindtap="selectItem"
      data-item="{{item}}"
    >
      <view class="result-info">
        <view class="result-name-row">
          <text class="result-name">{{item.name || '--'}}</text>
          <view class="result-status">
            <view wx:if="{{item.ischecked === true}}" class="status-tag status-checked">已记录</view>
            <view wx:elif="{{item.ischecked === false}}" class="status-tag status-unchecked">待记录</view>
            <view wx:else class="status-tag status-unknown">未设置</view>
          </view>
        </view>
        <view class="result-spec-row">
          <text class="result-spec">{{item.specification || '--'}}</text>
          <text class="result-id-text">ID：{{item.info}}</text>
        </view>
        <view class="result-meta-row">
          <text class="result-meta">批号:{{item.batch || '--'}} · 数量：</text>
          <text class="result-qty">{{item.quantity || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 物品信息卡片 -->
  <view class="goods-card card" wx:if="{{currentItem && !searchLoading}}">
    <!-- 名称作为卡片标题 -->
    <view class="card-title-wrap">
      <view class="card-title-row">
        <text class="card-title">{{currentItem.name || '--'}}（ID：{{currentItem.info}}）</text>
      </view>
      <view class="card-close" bindtap="closeGoodsCard">✕</view>
    </view>
    <view class="goods-info-row">
      <text class="info-label">规格</text>
      <text class="info-value">{{currentItem.specification || '--'}}</text>
    </view>
    <view class="goods-info-row">
      <text class="info-label">生产厂家</text>
      <text class="info-value">{{currentItem.manufacturer || '--'}}</text>
    </view>
    <view class="goods-info-row">
      <text class="info-label">批号</text>
      <text class="info-value">{{currentItem.batch || '--'}}</text>
    </view>
    <view class="goods-info-row">
      <text class="info-label">有效期至</text>
      <view class="info-value" style="display:flex;align-items:center;justify-content:flex-end;gap:8rpx;">
        <text class="{{isItemExpired ? 'text-danger' : ''}}">{{currentItem.expire_date || '--'}}</text>
        <text class="tag-danger" wx:if="{{isItemExpired}}">已过期</text>
      </view>
    </view>
    <!-- 记录状态 -->
    <view class="goods-info-row">
      <text class="info-label">状态</text>
      <view class="info-value" style="display:flex;align-items:center;justify-content:flex-end;">
        <view wx:if="{{currentItem.ischecked === true}}" class="status-tag status-checked">已记录</view>
        <view wx:elif="{{currentItem.ischecked === false}}" class="status-tag status-unchecked">待记录</view>
        <view wx:else class="status-tag status-unknown">未记录</view>
      </view>
    </view>
    <!-- 当前货位行：展示物品自己的货位，点击可设置全局指定货位 -->
    <view class="goods-info-row allocation-row" bindtap="openAllocationDialog">
      <text class="info-label">当前货位</text>
      <view class="info-value allocation-value">
        <text wx:if="{{currentItem.allocation_name}}" class="allocation-text">{{currentItem.allocation_name}}</text>
        <text wx:elif="{{specifiedAllocationName}}" class="allocation-text">由：{{currentItem.allocation_name || '(空货位)'}} 更新为：{{specifiedAllocationName}}</text>
        <text wx:else class="allocation-placeholder">点击设置货位</text>
        <text class="arrow-right">›</text>
      </view>
    </view>

    <!-- 数量对比 - 4:6 布局 -->
    <view class="qty-compare">
      <view class="qty-box qty-record">
        <text class="qty-label">记录数量</text>
        <text class="qty-value">{{quantityDisplay}}</text>
      </view>

      <view class="qty-box qty-actual">
        <text class="qty-label">实际数量</text>
        <view class="qty-input-wrap">
          <view class="qty-btn-minus" bindtap="onQtyMinus">-</view>
          <input
            class="qty-input {{deltaClass}}"
            type="digit"
            value="{{actualQty}}"
            placeholder="输入实际数量"
            bindinput="onActualQtyInput"
            bindconfirm="handleSubmitCheck"
            adjust-position="{{true}}"
          />
          <view class="qty-btn-plus" bindtap="onQtyPlus">+</view>
        </view>
      </view>
    </view>

    <!-- 提交按钮 - 固定在底部，动态显示状态 -->
    <view class="submit-wrap">
      <button
        class="btn-submit {{deltaClass}}"
        bindtap="handleSubmitCheck"
        disabled="{{submitLoading || actualQty === ''}}"
        loading="{{submitLoading}}"
      >{{submitBtnText}}</button>
    </view>
  </view>

  <!-- 透明占位：撑开底部空间，让卡片可上滑不被固定按钮遮挡 -->
  <view class="spacer" wx:if="{{currentItem && !searchLoading}}"></view>

  <!-- 未找到提示 - 仅在有搜索关键词时显示 -->
  <view class="empty-state" wx:if="{{searchKey && searched && !currentItem && searchResults.length === 0 && !searchLoading}}">
    <text class="empty-text">未找到</text>
  </view>

  <!-- 初始状态提示 - 无搜索关键词时显示扫码图标 -->
  <view
    class="empty-state"
    wx:if="{{!searchKey && !currentItem && !searchLoading && searchResults.length === 0}}"
  >
    <view class="empty-icon-wrap" bindtap="handleScan">
      <view class="scan-icon-large">
        <view class="scan-frame-large">
          <view class="scan-line-large"></view>
        </view>
      </view>
    </view>
    <text class="empty-text">请扫条码或输入物品信息</text>
    <text class="empty-hint">点击上方图标扫码</text>
  </view>

  <!-- 货位选择弹窗 -->
  <view class="modal-mask" wx:if="{{showAllocationDialog}}" bindtap="closeAllocationDialog">
    <view class="modal-dialog" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">编辑货位</text>
        <text class="modal-close" bindtap="closeAllocationDialog">✕</text>
      </view>

      <view class="modal-body">
        <!-- 搜索输入 -->
        <view class="modal-search-wrap">
          <input
            class="modal-search-input"
            placeholder="搜索货位"
            value="{{allocationSearchKey}}"
            bindinput="onAllocationSearchInput"
          />
        </view>

        <!-- 货位列表 -->
        <scroll-view class="allocation-list" scroll-y>
          <view
            class="allocation-item {{selectedAllocationId === item.id ? 'selected' : ''}}"
            wx:for="{{filteredAllocations}}"
            wx:key="id"
            bindtap="selectAllocation"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
          >
            <text class="allocation-item-name">{{item.name}}</text>
            <text wx:if="{{selectedAllocationId === item.id}}" class="allocation-check">✓</text>
          </view>
          <view wx:if="{{filteredAllocations.length === 0}}" class="allocation-empty">
            未找到货位
          </view>
        </scroll-view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn btn-create" bindtap="openCreateAllocationDialog">新增</button>
        <button class="modal-btn btn-cancel" bindtap="closeAllocationDialog">取消</button>
        <button class="modal-btn btn-confirm" bindtap="confirmAllocation">确定</button>
      </view>
    </view>
  </view>

  <!-- 新增货位弹窗 -->
  <view class="modal-mask" wx:if="{{showCreateAllocationDialog}}" bindtap="closeCreateAllocationDialog">
    <view class="modal-dialog modal-dialog-small" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">新增货位</text>
        <text class="modal-close" bindtap="closeCreateAllocationDialog">✕</text>
      </view>

      <view class="modal-body">
        <view class="create-allocation-wrap">
          <input
            class="create-allocation-input"
            placeholder="输入货位名称"
            value="{{newAllocationName}}"
            bindinput="onNewAllocationInput"
            focus="{{true}}"
          />
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn btn-cancel" bindtap="closeCreateAllocationDialog">取消</button>
        <button class="modal-btn btn-confirm" bindtap="submitCreateAllocation">确定</button>
      </view>
    </view>
  </view>
</view>

<!-- 提交成功大勾提示 -->
<view class="success-overlay" wx:if="{{showSuccessOverlay}}">
  <view class="success-card">
    <view class="success-check">✓</view>
    <text class="success-msg">{{successOverlayMsg}}</text>
  </view>
</view>
