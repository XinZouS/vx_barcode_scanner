/* pages/stock-check/stock-check.wxss */

.container {
  min-height: 100vh;
  background-color: #e8f5e8;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部标题区域 - 复用 index 页面样式 */
.header {
  background: linear-gradient(135deg, #5cb85c 0%, #4cae4c 100%);
  padding: 30rpx 30rpx 20rpx;  /* 减小上下 padding，让绿色区域更紧凑 */
  color: white;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-wrapper {
  flex:1;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity:0.9;
}

/* 进度展示 */
.progress-section {
  margin-top: 20rpx;  /* 减小间距，让绿色区域更紧凑 */
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 20rpx;
}

.progress-label {
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.progress-checked {
  font-weight: bold;
  font-size: 32rpx;
}

.progress-unchecked {
  font-weight: bold;
  font-size: 32rpx;
  color: #ffd700;
}

.progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: white;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 开始统计按钮 - 白底浅绿，绿色文字 */
.start-btn-wrap {
  margin-top: 20rpx;  /* 减小间距，让绿色区域更紧凑 */
}

.btn-start {
  background: rgba(255, 255, 255, 0.95);
  color: #5cb85c;
  border-radius: 50rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn-start:active {
  background: rgba(255, 255, 255, 0.8);
}

.btn-restart {
  background: rgba(255, 243, 224, 0.95);
  color: #ff8c00;
  border-radius: 50rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn-restart:active {
  background: rgba(255, 243, 224, 0.8);
}

/* 右上角按钮组 */
.header-btns {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 手动报溢按钮 */
.btn-overflow-small {
  background: rgba(255, 255, 255, 0.25) !important;
  color: white !important;
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  font-size: 23rpx;
  font-weight: bold;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  line-height: 1.5;
  flex-shrink: 0;
  width: auto !important;
  display: inline-block;
}

.btn-overflow-small:active {
  background: rgba(255, 255, 255, 0.4);
}

/* 重新开始按钮 - 右上角小型按钮 */
.btn-restart-small {
  background: rgba(255, 243, 224, 0.95) !important;
  color: #ff8c00 !important;
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  font-size: 23rpx;  /* 减小1号：24→23 */
  font-weight: bold;
  border: none;
  line-height: 1.5;
  flex-shrink: 0;
  width: auto !important;  /* 覆盖微信 button 默认宽度100% */
  display: inline-block;
}

.btn-restart-small:active {
  background: rgba(255, 243, 224, 0.8);
}

/* 搜索区域 */
.search-section {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-top: 20rpx;  /* 增加与上方绿色区域的间距 */
  padding: 20rpx 30rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 15rpx 25rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  color: #999;
  font-size: 34rpx;  /* 加大 6rpx：28→34 */
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
  height: 100%;
  padding: 0 5rpx;
  margin-right: -5rpx;  /* 让 X 靠右，视觉上向右移动 */
}

/* 图标按钮 - 蓝色 */
.icon-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1989fa;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(25, 137, 250, 0.3);
}

.icon-btn:active {
  background: #0570e6;
}

/* 扫码图标按钮 - 统一用细线条风格 */
.scan-icon-btn {
  width: 48rpx;
  height: 48rpx;
  position: relative;
}

.scan-frame-line {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid white;
  border-radius: 6rpx;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
}

.scan-frame-line::after {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 3rpx;
  background: white;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation: scanMoveSmall 2s infinite;
}

@keyframes scanMoveSmall {
  0%, 100% {
    top: 20%;
  }
  50% {
    top: 80%;
  }
}

/* 放大镜图标 */
.magnifier-icon {
  width: 39rpx;
  height: 39rpx;
  position: relative;
}

.magnifier-circle {
  width: 25rpx;
  height: 25rpx;
  border: 3rpx solid white;
  border-radius: 50%;
  position: absolute;
  top: 7rpx;
  left: 7rpx;
}

.magnifier-handle {
  width: 3rpx;
  height: 11rpx;
  background: white;
  border-radius: 2rpx;
  position: absolute;
  bottom: 3rpx;
  right: 8rpx;
  transform: rotate(-45deg);
}

/* Loading 提示 */
.loading-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  gap: 15rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #1989fa;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 搜索结果列表 */
.search-results {
  margin: 20rpx 30rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.result-item {
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #d0d0d0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-item:active {
  background: #f5f5f5;
}

.result-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.result-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.result-spec {
  font-size: 30rpx;
  color: #666;
  display: block;
  margin-bottom: 5rpx;
}

.result-spec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 5rpx;
}

.result-id-text {
  font-size: 30rpx;
  color: #666;
  flex-shrink: 0;
}

.result-meta {
  font-size: 28rpx;
  color: #999;
}

.result-meta-row {
  display: flex;
  align-items: center;
}

.result-qty {
  color: #1989fa;
  font-weight: 500;
}

.result-status {
  flex-shrink: 0;
}

.status-tag {
  display: inline-block;
  font-size: 30rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-weight: 500;
  white-space: nowrap;
}

.status-checked {
  background: #e8f5e8;
  color: #5cb85c;
}

.status-unchecked {
  background: #fff7e6;
  color: #e6a23c;
}

.status-unknown {
  background: #f5f5f5;
  color: #999;
}

/* 物品信息卡片 */
.goods-card {
  margin-top: 30rpx;
}

/* 卡片内容自动高度 */
.goods-card .goods-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;  /* 垂直居中 */
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  min-height: 60rpx;
}

.goods-card .info-value {
  font-size: 30rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
  word-wrap: break-word;
  white-space: normal;
  line-height: 1.5;
}

.card-title-row {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 12rpx;
  min-width: 0;  /* 防止 flex 子元素溢出 */
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  word-break: break-all;
  line-height: 1.4;
}

/* 卡片标题前的盘点状态 tag */
.card-status-tag {
  font-size: 32rpx;
  padding: 6rpx 18rpx;
  border-radius: 6rpx;
  font-weight: 600;
  flex-shrink: 0;
  white-space: nowrap;
}

.status--checked {
  background: rgba(103, 194, 58, 0.15);
  color: #67c23a;
}

.status--unchecked {
  background: rgba(230, 162, 60, 0.15);
  color: #e6a23c;
}

.status--null {
  background: #f0f0f0;
  color: #999;
}

.card-title-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-close {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f0;
  color: #fa5151;
  border-radius: 50%;
  font-size: 36rpx;
  flex-shrink: 0;
}

.card-close:active {
  background: #ffe0e0;
}

.goods-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;  /* 垂直居中，与整体一致 */
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  min-height: 60rpx;
}

.goods-info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 29rpx;  /* 加大1号：28→29 */
  color: #666;
  flex-shrink: 0;
}

.info-value {
  font-size: 29rpx;  /* 加大1号：28→29 */
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.text-danger {
  color: #fa5151;
}

.tag-danger {
  display: inline-block;
  background: #fff0f0;
  color: #fa5151;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
}

/* ─── 绿色分隔线 — 对齐 Vue card-divider ─── */
.card-divider {
  height: 0;
  border-top: 3rpx solid #5cb85c;
  margin: 16rpx 0;
  border-radius: 2rpx;
}

/* ─── 数量四段流容器 ─── */
.qty-flow {
  margin: 4rpx 0 8rpx;
}

.qty-flow-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.qty-flow-row--input {
  align-items: flex-start;
}

/* 数量流方块 */
.qty-flow-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 80rpx;
}

.qty-flow-box--input {
  flex: 2;
}

.qty-flow-box--delta {
  flex: 1.2;
}

.qty-flow-label {
  font-size: 28rpx;
  color: #999;
}

.qty-flow-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  line-height: 1;
}

.qty-flow-value--big {
  font-size: 42rpx;
}

.qty-flow-value--record {
  color: #1989fa;
}

.qty-flow-value--muted {
  color: #888;
  font-size: 42rpx;
}

.qty-flow-arrow {
  font-size: 52rpx;
  color: #888;
  align-self: center;
  flex-shrink: 0;
  padding-bottom: 30rpx;  /* 对齐上方的 label 高度 */
}

/* 已盘数量颜色 */
.qty-red {
  color: #f56c6c !important;
}

.qty-green {
  color: #67c23a !important;
}

.qty-yellow {
  color: #e6a23c !important;
}

.qty-gray {
  color: #c0c4cc !important;
}

/* 本次增加输入 */
.qty-flow-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.qty-flow-input {
  flex: 1;
  text-align: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #5cb85c;
  border-bottom: 4rpx solid #5cb85c;
  padding: 8rpx 0;
  min-width: 100rpx;
  transition: all 0.3s;
}

.qty-flow-input.delta-ok {
  color: #5cb85c;
  border-bottom-color: #5cb85c;
  background: rgba(92, 184, 92, 0.08);
  border-radius: 8rpx 8rpx 0 0;
}

.qty-flow-input.delta-loss {
  color: #f56c6c;
  border-bottom-color: #f56c6c;
  background: rgba(245, 108, 108, 0.08);
  border-radius: 8rpx 8rpx 0 0;
}

.qty-flow-input.delta-overage {
  color: #e6a23c;
  border-bottom-color: #e6a23c;
  background: rgba(230, 162, 60, 0.08);
  border-radius: 8rpx 8rpx 0 0;
}

.qty-btn-minus,
.qty-btn-plus {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.qty-btn-minus {
  background: #f56c6c;
  color: white;
}

.qty-btn-minus:active {
  background: #e04040;
}

.qty-btn-plus {
  background: #67c23a;
  color: white;
}

.qty-btn-plus:active {
  background: #4cae4c;
}

/* 差值颜色 */
.delta-loss {
  color: #f56c6c !important;
}

.delta-overage {
  color: #e6a23c !important;
}

.delta-ok {
  color: #67c23a !important;
}

/* 差值 tag */
.delta-tag {
  font-size: 26rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.delta-tag--loss {
  background: rgba(245, 108, 108, 0.15);
  color: #f56c6c;
}

.delta-tag--overflow {
  background: rgba(230, 162, 60, 0.15);
  color: #e6a23c;
}

/* 已盘修改提示 — 对齐 Vue already-checked-hint */
.already-checked-hint {
  margin-bottom: 14rpx;
}

.hint-box {
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.hint-box--loss {
  background: rgba(245, 108, 108, 0.08);
  color: #f56c6c;
  border-left: 4rpx solid #f56c6c;
}

.hint-box--overflow {
  background: rgba(230, 162, 60, 0.08);
  color: #e6a23c;
  border-left: 4rpx solid #e6a23c;
}

/* ─── 提交区域 — 内联全宽 ─── */
.submit-area {
  margin-top: 30rpx;
}

.submit-area .btn-submit {
  width: 100%;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  transition: all 0.3s;
}

.submit-area .btn-submit.delta-ok {
  background: rgba(103, 194, 58, 0.15);
  color: #67c23a;
  border: 2rpx solid #67c23a;
}

.submit-area .btn-submit.delta-loss {
  background: rgba(245, 108, 108, 0.12);
  color: #f56c6c;
  border: 2rpx solid #f56c6c;
}

.submit-area .btn-submit.delta-overage {
  background: rgba(230, 162, 60, 0.12);
  color: #e6a23c;
  border: 2rpx solid #e6a23c;
}

.submit-area .btn-submit:active {
  opacity: 0.8;
}

.submit-area .btn-submit[disabled] {
  background: #f5f5f5 !important;
  color: #999 !important;
  border-color: #e0e0e0 !important;
}

/* 等宽字体 */
.mono {
  font-family: 'Courier New', monospace;
}

/* 货位可点击链接 */
.allocation-link {
  color: #1989fa;
  font-size: 28rpx;
  font-weight: bold;
}

/* info-value row（有效期行） */
.info-value-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

/* ─── 绿色分隔线 — 对齐 Vue card-divider ─── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon-wrap {
  width: 200rpx;
  height: 200rpx;
  background-color: #e8f5e8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(92, 184, 92, 0.2);
}

.empty-icon-wrap:active {
  background-color: #d4efd4;
}

.scan-icon-large {
  width: 120rpx;
  height: 120rpx;
  position: relative;
}

.scan-frame-large {
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid #5cb85c;
  border-radius: 10rpx;
  position: absolute;
  top: 10rpx;
  left: 10rpx;
}

.scan-line-large {
  width: 80rpx;
  height: 4rpx;
  background-color: #5cb85c;
  position: absolute;
  top: 50rpx;
  left: 50%;
  transform: translateX(-50%);
  animation: scanMove 2s infinite;
}

@keyframes scanMove {
  0%, 100% {
    top: 20rpx;
  }
  50% {
    top: 80rpx;
  }
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
  margin-bottom: 30rpx;
}

/* ===== 货位行样式 ===== */
.allocation-row {
  position: relative;
}

.allocation-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.allocation-text {
  color: #1989fa;
  font-size: 36rpx;
}

.allocation-placeholder {
  color: #999;
  font-size: 29rpx;
}

.arrow-right {
  color: #999;
  font-size: 32rpx;
}

/* ===== 指定货位（全局）区域 ===== */
.specified-allocation-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  margin-top: 20rpx;
}

.specified-allocation-row {
  display: flex;
  align-items: center;
  flex: 1;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.specified-allocation-row:active {
  background: #e8e8e8;
}

/* 覆盖 info-label/info-value 在指定货位区域中的样式 */
.specified-allocation-row .info-label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.specified-allocation-row .allocation-value {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
  gap: 8rpx;
}

.specified-allocation-row .allocation-text {
  color: #1989fa;
  font-size: 36rpx;
}

.specified-allocation-row .allocation-placeholder {
  color: #999;
  font-size: 28rpx;
}

.specified-allocation-row .arrow-right {
  color: #999;
  font-size: 32rpx;
}

/* 自动关联 switch 区域 */
.auto-link-row {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.auto-link-label {
  font-size: 28rpx;
  color: #999;
  margin-right: 8rpx;
}

/* ===== 弹窗样式 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-dialog {
  width: 85%;
  max-height: 80vh;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-dialog-small {
  width: 70%;
  max-height: 50vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.modal-search-wrap {
  margin-bottom: 20rpx;
}

.modal-search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.allocation-list {
  height: 600rpx;
}

.allocation-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.allocation-item:active {
  background: #f5f5f5;
}

.allocation-item.selected {
  background: rgba(25, 137, 250, 0.08);
  color: #1989fa;
  font-weight: bold;
}

.allocation-item-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.allocation-check {
  color: #1989fa;
  font-size: 32rpx;
  font-weight: bold;
}

.allocation-empty {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.create-allocation-wrap {
  margin-bottom: 20rpx;
}

.create-allocation-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  padding: 12rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  line-height: 1.5;
}

.btn-create {
  background: #1989fa;
  color: white;
}

.btn-create:active {
  background: #0570e6;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-cancel:active {
  background: #e0e0e0;
}

.btn-confirm {
  background: #5cb85c;
  color: white;
}

.btn-confirm:active {
  background: #4cae4c;
}

/* ===== 提交成功浮层 ===== */
.success-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  z-index: 3000;
  animation: fadeIn 0.2s ease;
}

.success-card {
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  animation: popIn 0.3s ease;
}

.success-check {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #5cb85c;
  color: white;
  font-size: 64rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.success-msg {
  font-size: 34rpx;
  font-weight: bold;
  color: #5cb85c;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes popIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 完成统计菜单卡片 */
.finish-menu-card {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.finish-menu-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.finish-menu-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.btn-finish {
  background: #5cb85c !important;
  color: white !important;
  border-radius: 50rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(92, 184, 92, 0.3);
  margin-bottom: 20rpx;
  width: 100%;
  border: none;
  line-height: 1.5;
}

.btn-finish:active {
  background: #4cae4c !important;
}

.btn-restart-confirm {
  background: rgba(255, 243, 224, 0.95) !important;
  color: #ff8c00 !important;
  border-radius: 50rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
  width: 100%;
  border: none;
  line-height: 1.5;
}

.btn-restart-confirm:active {
  background: rgba(255, 243, 224, 0.8) !important;
}

.btn-cancel-menu {
  background: #f5f5f5 !important;
  color: #666 !important;
  border-radius: 50rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  width: 100%;
  border: none;
  line-height: 1.5;
}

.btn-cancel-menu:active {
  background: #e0e0e0 !important;
}
