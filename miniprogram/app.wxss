/**app.wxss**/
page {
  background-color: #f0f9f0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* 全局按钮样式 */
button {
  background: initial;
  padding: 0;
  margin: 0;
  border-radius: 0;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* 主题色变量 */
.theme-bg {
  background-color: #5cb85c;
}

.theme-bg-light {
  background-color: #e8f5e8;
}

.theme-text {
  color: #5cb85c;
}

.theme-text-dark {
  color: #4cae4c;
}

/* 通用卡片样式 */
.card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 通用按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #5cb85c 0%, #4cae4c 100%);
  color: white;
  border-radius: 50rpx;
  padding: 25rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(92, 184, 92, 0.3);
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #666;
  border-radius: 50rpx;
  padding: 25rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

/* 通用文本样式 */
.text-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.text-subtitle {
  font-size: 28rpx;
  color: #666;
}

.text-hint {
  font-size: 24rpx;
  color: #999;
}

/* 通用布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
